#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# Opens a child's own Steam in a window on a Guardian's desktop, and closes
# it again (ADR-0032). One opening is a visit. The Guardian's window runs
# this once per visit through pkexec, which asks for the Guardian's password
# or fingerprint; this one root process then lasts until the visit closes.
#
#   pkexec /usr/local/libexec/cairn/cairn-steam-visit CHILD
#
# It says how the visit is going on stdout, one line at a time: "waiting"
# while the child's last login finishes ending, "open", then "closing" and
# "closed". "stuck" means a program of the child would not end, and the
# computer needs a restart. "refused REASON" means no visit was opened.
# A line "done" on stdin, or the end of stdin, closes the visit, and so do
# cage or Steam ending, a login of the child's, and a signal.
#
# The child cannot log in while their visit is open: their name is in
# /run/cairn/steam-visits, which PAM reads for the login screen and the
# consoles (session/sddm/pam.d/sddm, session/pam.d/login).
#
# A copy uses the same list to copy the shared games into a child's own
# Steam library (ADR-0033), as root and never through pkexec:
#
#   /usr/local/libexec/cairn/cairn-steam-visit --copy-games CHILD --all
#   /usr/local/libexec/cairn/cairn-steam-visit --copy-games CHILD [APPID...]
#
# Two programs start one. Provisioning runs it as root from a terminal. On
# the image, the Guardian tool's Save runs `cairn-family save-games` through
# pkexec, and cairn-family starts this as a system job with systemd-run
# (ADR-0041), so it runs with the service manager's environment, not the
# Guardian's, and a Guardian who logs out cannot end it halfway.
#
# "--all" copies every game in the shared library, as the kids' laptop still
# does. Appids copy only those games, the child's own list (ADR-0041), and
# no appids copy nothing, so an empty list never means every game. An appid
# that is not a plain number, "--all" among them, is refused with
# "refused appid".
#
# It says "waiting" as a visit does, then passes on only the copy program's
# own lines ("copied APPID", "skipped APPID REASON", ...; see
# provision/cairn-copy-games.py), and ends with "finished", or "failed" when
# the copy program did not end well. "refused REASON" means nothing was
# copied. A visit tried meanwhile is refused with "copying". Provisioning
# prints only sentences of its own, so a copy also leaves a record of each of
# these lines but "have" in the journal, and of why it was refused or failed.
set -ouex pipefail

# The copy of cage that the child may run but not read. Linux will not let
# another process of the same account trace a program it cannot read, nor
# copy its open files, so the child's other programs cannot take cage's
# connection to the Guardian's desktop (ADR-0032).
CAGE=/usr/local/libexec/cairn/cage-visit
COPY_GAMES=/usr/local/libexec/cairn/cairn-copy-games
PYTHON=/usr/bin/python3
RUN_DIR=/run/cairn
VISITS="$RUN_DIR/steam-visits"
# Says that a copy, not a visit, holds the list. Only this helper reads it.
COPYING="$RUN_DIR/steam-copy"
RUNTIME_ROOT=/run/user
X11_DIR=/tmp

# How long Steam gets to save and quit (18 s was seen), and how long the
# child's last programs get to end before they are killed.
STEAM_SECONDS=25
END_SECONDS=15
# How long a login that loginctl has ended may still show while it closes.
CLOSE_SECONDS=5

caller=""
child=""
child_uid=""
unit=""
# Whether the child is on the list of children on a visit, and whether
# their visit has started. From the moment they are listed, whatever ends
# this script undoes what it can (close_visit).
listed=no
opened=no
# Whether this run copies games rather than opens a visit, and whether it
# wrote the marker that a copy holds the list.
copying=no
marked=no
# A signal only sets this, and the visit ends at the next check. Leaving
# from inside the trap would end `read -t` before its timer, and bash
# crashed when that timer went off later, halfway through the close.
stopping=no

say() {
    echo "$1" || true
}

# One line in the journal for a grown-up to read later (#85).
note() {
    logger --tag cairn-steam-visit -- "$1" || true
}

# Steam's appids, in the one form kidscan accepts: no sign, no leading 0.
is_appid() {
    [[ "$1" =~ ^[1-9][0-9]{0,9}$ ]]
}

refuse() {
    say "refused $1"
    [ "$copying" = no ] || note "no games were copied for ${child:-a child}: refused $1"
    exit 1
}

groups_of() {
    id -nG -- "$1"
}

in_any_group() {
    local name="$1" group wanted
    shift
    for group in $(groups_of "$name"); do
        for wanted in "$@"; do
            [ "$group" != "$wanted" ] || return 0
        done
    done
    return 1
}

is_administrator() {
    in_any_group "$1" cairn-guardian wheel
}

is_child() {
    ! is_administrator "$1" && in_any_group "$1" cairn-l1 cairn-l2 cairn-l3 cairn-l4
}

# The SELinux type of a file, or nothing when SELinux is off.
label_of() {
    if selinuxenabled; then
        stat --format=%C -- "$1" | cut -d: -f3
    fi
}

# Each of the child's sessions: its id, class and PAM service.
child_sessions() {
    local id
    for id in $(loginctl show-user "$child" --property=Sessions --value 2> /dev/null || true); do
        echo "$id $(loginctl show-session "$id" --property=Class --value) $(loginctl show-session "$id" --property=Service --value)"
    done
}

# A login of the child's own, as opposed to their service manager or this
# visit's session.
child_logged_in() {
    local id class service
    while read -r id class service; do
        [ -n "$id" ] || continue
        case "$class" in manager*) continue ;; esac
        [ "$service" != cairn-steam-visit ] || continue
        return 0
    done < <(child_sessions)
    return 1
}

child_has_processes() {
    pgrep --uid "$child_uid" > /dev/null
}

# True once nothing of the child is left, or false after SECONDS.
wait_for_no_processes() {
    local seconds="$1"
    for _ in $(seq "$seconds"); do
        child_has_processes || return 0
        sleep 1
    done
    ! child_has_processes
}

# Steam writes its state, and a game's last cloud save, when told to shut
# down. Only if it is running: asked to shut down when it is not, it starts.
shut_down_steam() {
    pgrep --uid "$child_uid" --exact steam > /dev/null || return 0
    local home socket
    home="$(getent passwd "$child" | cut -d: -f6)"
    local environment=(HOME="$home" USER="$child" LOGNAME="$child" PATH=/usr/bin:/bin
        XDG_RUNTIME_DIR="$RUNTIME_ROOT/$child_uid")
    # cage's own X display, where the child's Steam runs: the child's first.
    for socket in "$X11_DIR"/.X11-unix/X*; do
        if [ -S "$socket" ] && [ "$(stat --format=%u -- "$socket")" = "$child_uid" ]; then
            environment+=(DISPLAY=":${socket##*/X}")
            break
        fi
    done
    timeout "$STEAM_SECONDS" setpriv --reuid="$child_uid" --regid="$(id -g -- "$child")" --init-groups \
        env -i "${environment[@]}" /usr/bin/steam -shutdown > /dev/null 2>&1 < /dev/null || true
    for _ in $(seq "$STEAM_SECONDS"); do
        pgrep --uid "$child_uid" --exact steam > /dev/null || return 0
        sleep 1
    done
}

# Ends every session of the child's and their service manager, then kills
# whatever of theirs is left. False when a program of theirs still would
# not end. Each step goes ahead whatever the one before it answered.
end_child() {
    loginctl terminate-user "$child" || true
    if ! wait_for_no_processes "$END_SECONDS"; then
        pkill --signal KILL --uid "$child_uid" || true
        wait_for_no_processes 5 || true
    fi
    # A killed Xwayland leaves its socket and lock behind, and the next
    # shut_down_steam would take that socket for the child's display.
    find "$X11_DIR/.X11-unix" -maxdepth 1 -name 'X*' -user "$child_uid" -delete 2> /dev/null || true
    find "$X11_DIR" -maxdepth 1 -name '.X*-lock' -user "$child_uid" -delete 2> /dev/null || true
    ! child_has_processes
}

# Every ending of a visit comes here, once (ADR-0032). Before the visit
# started, taking the child off the list is all there is to undo.
close_visit() {
    local status=$?
    if [ "$opened" != yes ]; then
        [ "$listed" = no ] || rm -f -- "$VISITS"
        return "$status"
    fi
    opened=no
    set +e
    say closing
    shut_down_steam
    systemctl stop "$unit" 2> /dev/null
    # The visit's session and the child's service manager. The child has no
    # other session: the visit opened only while they had none, and PAM
    # refuses their login until the list below no longer names them.
    if ! end_child; then
        # The child stays refused at login until a restart empties /run.
        note "$child's Steam visit could not close: a program of theirs would not end; restart the computer"
        say stuck
        exit 1
    fi
    rm -f -- "$VISITS"
    note "$caller closed $child's Steam visit"
    say closed
    exit "$status"
}

# cage takes a moment to start in its new session.
cage_running() {
    for _ in $(seq 10); do
        [ "$stopping" = no ] || return 1
        pgrep --uid "$child_uid" --exact cage-visit > /dev/null && return 0
        sleep 1
    done
    return 1
}

# Wait for "done" or the end of stdin, while the visit runs. A login of the
# child's that got past PAM would share this Steam, so it ends the visit too.
watch_visit() {
    local line
    while [ "$stopping" = no ]; do
        if read -r -t 2 line; then
            [ "$line" != "done" ] || return 0
        elif [ $? -le 128 ]; then
            return 0
        fi
        pgrep --uid "$child_uid" --exact cage-visit > /dev/null || return 0
        ! child_logged_in || return 0
    done
}

# A child's account and its uid, or a refusal: never an administrator, and
# never an account Cairn did not make.
take_child() {
    local name="$1"
    [[ "$name" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || refuse not-a-child
    getent passwd "$name" > /dev/null || refuse not-a-child
    is_child "$name" || refuse not-a-child
    child="$name"
    child_uid="$(id -u -- "$child")"
}

make_run_dir() {
    [ -d "$RUN_DIR" ] || mkdir --mode=0755 "$RUN_DIR"
    restorecon "$RUN_DIR"
}

# Names the child in the list, unless the list names anyone already: one
# child at a time on the machine.
list_child() {
    (set -o noclobber && echo "$child" > "$VISITS") 2> /dev/null || return 1
    listed=yes
}

# Why the list was taken: a copy says so in its marker.
busy_reason() {
    if [ -e "$COPYING" ]; then
        echo copying
    else
        echo busy
    fi
}

# PAM lets everyone in when it cannot read the list, and SELinux keeps the
# login screen from reading a plain file in /run. Provisioning labels
# /run/cairn so that it can; without that label nothing goes ahead.
check_list() {
    chmod 0644 "$VISITS"
    restorecon "$VISITS"
    local label
    label="$(label_of "$VISITS")"
    if [ -n "$label" ] && [ "$label" != etc_t ]; then
        refuse not-set-up
    fi
}

# Only once the child is listed, so they cannot log in after this.
wait_for_logout() {
    ! child_logged_in || refuse logged-in
    # After a logout, the child's service manager takes a few seconds to end.
    if child_has_processes; then
        say waiting
        wait_for_no_processes "$END_SECONDS" || refuse still-running
    fi
    [ "$stopping" = no ] || refuse stopped
}

# True once the child has no login left, or false after SECONDS or a
# signal.
wait_for_no_login() {
    local seconds="$1"
    for _ in $(seq "$seconds"); do
        [ "$stopping" = no ] || return 1
        child_logged_in || return 0
        sleep 1
    done
    ! child_logged_in
}

# Logs the child out for a grown-up (ADR-0041). Only once the child is
# listed, so PAM refuses a new login of theirs meanwhile. Steam gets its
# moment to save first, as at a visit's close.
log_out_child() {
    [ "$stopping" = no ] || refuse stopped
    say logging-out
    note "logging $child out to copy their games"
    shut_down_steam
    [ "$stopping" = no ] || refuse stopped
    if ! end_child; then
        note "$child could not be logged out: a program of theirs would not end; restart the computer"
        refuse stuck
    fi
    if ! wait_for_no_login "$CLOSE_SECONDS"; then
        [ "$stopping" = no ] || refuse stopped
        refuse logged-in
    fi
    say logged-out
}

# A copy ends here, however it ends, and lets the child log in again.
release_copy() {
    local status=$?
    [ "$listed" = no ] || rm -f -- "$VISITS"
    [ "$marked" = no ] || rm -f -- "$COPYING"
    return "$status"
}

# The copy program's own lines (provision/cairn-copy-games.py), and only
# those: fixed words and appids, never anything from the child's home.
is_copy_line() {
    [[ "$1" =~ ^(copied|have)\ [0-9]{1,10}$ ]] ||
        [[ "$1" =~ ^skipped\ [0-9]{1,10}\ [a-z-]{1,32}$ ]] ||
        [[ "$1" =~ ^(unnumbered|no-library|no-shared|lists-shared|unreadable-config|no-reflink)$ ]]
}

# The copy runs as the child, from a root-owned program, with nothing of
# root's environment, and Python's -I keeps the child's files off its path.
# What it says on its error output could name a file in the child's home,
# so it goes nowhere. The trace is off while its lines are read, because it
# would print each line before it is checked.
run_copy() {
    local home line status=0 only=()
    [ "$#" -eq 0 ] || only=(--only "$@")
    home="$(getent passwd "$child" | cut -d: -f6)"
    # Provisioning runs from a checkout in the Guardian's own home, which
    # the child cannot open.
    cd /
    { set +x; } 2> /dev/null
    setpriv --reuid="$child_uid" --regid="$(id -g -- "$child")" --init-groups \
        env -i HOME="$home" USER="$child" LOGNAME="$child" PATH=/usr/bin:/bin \
        "$PYTHON" -I "$COPY_GAMES" "${only[@]}" < /dev/null 2> /dev/null |
        while IFS= read -r line; do
            is_copy_line "$line" || continue
            say "$line"
            [[ "$line" =~ ^have\  ]] || note "copying $child's games: $line"
        done || status=$?
    set -x
    return "$status"
}

# Provisioning's copy of the shared games into one child's library
# (ADR-0033), or of the games on their own list (ADR-0041). It takes the
# list a visit takes, so the child cannot log in and no visit opens until it
# ends.
copy_games() {
    copying=yes
    [ "$#" -ge 1 ] || refuse usage
    # A visit's polkit action must not become a way to start copies: pkexec
    # always sets PKEXEC_UID, and no caller can take it away. The one route
    # from a password box is cairn-family save-games, whose own polkit
    # action asks for it, and which starts this as a system job that
    # pkexec's environment never reaches (ADR-0041). Nothing here admits
    # cairn-family by name: only a root program could set or fake whatever
    # would.
    [ -z "${PKEXEC_UID:-}" ] || refuse not-for-pkexec
    [ "$(id -u)" = 0 ] || refuse not-root
    take_child "$1"
    shift
    # Every game only when asked for by name, so that an empty list can
    # never become every game.
    local every=no appid
    if [ "$#" -eq 1 ] && [ "$1" = --all ]; then
        every=yes
        shift
    fi
    # Every appid before anything changes, so one bad one copies nothing.
    for appid in "$@"; do
        is_appid "$appid" || refuse appid
    done
    if [ "$every" = no ] && [ "$#" -eq 0 ]; then
        note "nothing to copy for $child: their list is empty"
        say finished
        exit 0
    fi
    make_run_dir
    # The marker first, so that a visit refused by the list says why.
    (set -o noclobber && echo "$child" > "$COPYING") 2> /dev/null || refuse busy
    marked=yes
    trap release_copy EXIT
    list_child || refuse busy
    check_list
    wait_for_logout
    note "copying $child's games"
    if run_copy "$@"; then
        note "finished copying $child's games"
        say finished
    else
        note "copying $child's games failed: the copy program ended with status $?"
        say failed
        exit 1
    fi
    exit 0
}

main() {
    trap 'stopping=yes' TERM HUP INT
    if [ "${1:-}" = --copy-games ]; then
        shift
        copy_games "$@"
    fi
    [ "$#" -eq 1 ] || refuse usage
    [ "$(id -u)" = 0 ] || refuse not-root

    # pkexec has already asked for the password. polkit's rule refused any
    # account that is not an administrator before it asked (ADR-0023), and
    # this checks again.
    local caller_uid="${PKEXEC_UID:-}"
    [[ "$caller_uid" =~ ^[0-9]+$ ]] || refuse not-pkexec
    caller="$(id -nu -- "$caller_uid")" || refuse not-a-grown-up
    is_administrator "$caller" || refuse not-a-grown-up

    # Only on the Guardian's own desktop, in their active local session,
    # never on a path anyone passes in.
    [ "$(loginctl show-user "$caller_uid" --property=State --value 2> /dev/null)" = active ] || refuse no-desktop
    local socket="$RUNTIME_ROOT/$caller_uid/wayland-0"
    [ -S "$socket" ] && [ "$(stat --format=%u -- "$socket")" = "$caller_uid" ] || refuse no-desktop

    take_child "$1"
    unit="cairn-steam-visit-$child_uid"

    # One visit at a time on the machine. The list is written first, so the
    # child cannot log in between the checks below and the visit.
    make_run_dir
    list_child || refuse "$(busy_reason)"
    trap close_visit EXIT
    check_list
    wait_for_logout

    opened=yes
    note "$caller opened $child's Steam visit"
    # cage runs as the child, in a session of the child's own made by PAM,
    # on the Guardian's Wayland socket, which systemd opens and hands over.
    # Steam runs inside it, through bash: SELinux does not let a login start
    # Steam's script directly.
    systemd-run --quiet --collect --unit="$unit" --uid="$child" \
        --property=PAMName=cairn-steam-visit \
        --property=OpenFile="$socket:wayland" \
        --setenv=WAYLAND_SOCKET=3 --setenv=WLR_RENDERER=pixman \
        -- "$CAGE" -- /bin/bash -c 'exec /usr/bin/steam'
    cage_running || exit 1
    say open
    watch_visit
    exit 0
}

# Run when executed; only load the functions when a test sources the file.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    # A window that has gone away must not end this before the close does.
    trap '' PIPE
    PATH=/usr/sbin:/usr/bin
    main "$@"
fi
