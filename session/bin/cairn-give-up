#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# The way out of a stuck program at L1/L2 (ADR-0018, issue #41). The
# compositor runs this on the grown-up's key combination. It ends whatever a
# child launched, however frozen, and leaves the frame standing.
#
# The launcher starts every program in a systemd user scope of its own,
# cairn-app-*.scope (ADR-0025, #98), so ending those scopes ends a native
# program such as ScummVM and everything it started. A Flatpak app and a Steam
# game leave that scope for their own: a Flatpak app is a tree under `bwrap`, a
# Steam game a tree under Steam's `reaper`, so those are found too. The
# launcher, the compositor, the terminal, the session's own services and the
# Steam client are none of these, so nothing of ours is touched. A stopped
# process cannot act on a signal until it is continued, so every process is
# sent SIGCONT before the kill; that is what reaches an app frozen hard enough
# to ignore everything else.
set -ouex pipefail

# When the grown-up pressed the keys, in milliseconds. A tile the child taps
# after this is a new launch, not the one given up on, and the launcher keeps
# it (#287).
pressed_at="$(date +%s%3N)"

# The one child session this runs in; never another user's.
me="$(id -u)"

# Everything is found once, now, and only what was found is signalled. The
# windows go at the SIGTERM, so the child can tap a tile before the SIGKILL
# two seconds later; a sandbox or scope that tap starts is not one of these
# and is left alone (#287).

# A Flatpak app roots at a process called exactly `bwrap`. Steam's own
# interface runs in a sandbox called `srt-bwrap`, so the name is matched
# whole, never as part of a command line (#117).
flatpak_root='bwrap'
mapfile -t flatpaks < <(pgrep --uid "$me" --exact "$flatpak_root" || true)

# A Steam game roots at Steam's reaper: a process called exactly `reaper`
# started with the argument `SteamLaunch`. Both are checked, because the
# reaper's children are ended too and a command line that only mentions
# those words must never count. The game runs in the container the reaper
# starts. That container is an `srt-bwrap` like Steam's interface, but only
# a game's has a reaper for a parent, so it is found as a reaper's child,
# never by its name (#117). All are found now, before anything is
# signalled: once a reaper has gone, its children move to another parent.
mapfile -t named_reaper < <(pgrep --uid "$me" --exact reaper || true)
reapers=()
for pid in "${named_reaper[@]}"; do
    if grep --quiet --line-regexp --null-data SteamLaunch "/proc/$pid/cmdline" 2> /dev/null; then
        reapers+=("$pid")
    fi
done
containers=()
for reaper in "${reapers[@]}"; do
    mapfile -t -O "${#containers[@]}" containers < <(pgrep --uid "$me" --parent "$reaper" || true)
done
games=("${containers[@]}" "${reapers[@]}")

# The launcher's scopes, in this user's own systemd. The tests name their own.
units="${CAIRN_APP_UNITS:-cairn-app-*.scope}"
mapfile -t scopes < <(systemctl --user list-units --type=scope --plain --no-legend "$units" | awk '{ print $1 }' || true)

# The file the launcher watches to hear that this ran (ADR-0026).
told="${CAIRN_GIVE_UP_FILE:-${XDG_RUNTIME_DIR:-/nonexistent}/cairn/give-up}"

# SIGCONT so a stopped process can receive what follows; SIGTERM as a courtesy
# in case the app wants to flush; SIGKILL after a moment for anything left.
targets=("${flatpaks[@]}" "${games[@]}")
[ "${#targets[@]}" -eq 0 ] || kill -s CONT "${targets[@]}" 2> /dev/null || true
[ "${#scopes[@]}" -eq 0 ] || systemctl --user kill --signal CONT "${scopes[@]}" || true
[ "${#targets[@]}" -eq 0 ] || kill -s TERM "${targets[@]}" 2> /dev/null || true
[ "${#scopes[@]}" -eq 0 ] || systemctl --user kill --signal TERM "${scopes[@]}" || true
sleep 2
[ "${#targets[@]}" -eq 0 ] || kill -s KILL "${targets[@]}" 2> /dev/null || true
[ "${#scopes[@]}" -eq 0 ] || systemctl --user kill --signal KILL "${scopes[@]}" || true

# Then tell the launcher, so the tiles come back even if a window it was
# waiting on never closes. It made the file when it started; none means no
# launcher is listening. It is told when the keys were pressed, so a launch
# the child started since then goes on (#287).
if [ -f "$told" ]; then
    echo "$pressed_at" > "$told"
fi

exit 0
