#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# cairn-session: the one session entry, dispatched by the account's level
# group (ADR-0012, DESIGN §4.3). The greeter runs this for every account.
# It reads the groups of the user who logged in and hands the session to
# either the kiosk compositor with the launcher (L1, L2) or Plasma (L3, L4,
# Guardian). Nothing else is decided here.
#
# The order is the one PAM, polkit and the greeter use (ADR-0023): an
# administrator (cairn-guardian or wheel) first, then the kiosk levels, then
# the desktop levels, then accounts Cairn did not make.
#
# A child's language is the Guardian's (ADR-0058): a child's session takes
# the one Family wrote, and an L3 or L4 child's Plasma hides its language
# settings. That is a hide, not a wall: a start-up script in the child's
# own home can replace the list this script hands on (ADR-0058, Known
# limits).
#
# This is a trust boundary (CLAUDE.md), so it stays short: the tests in
# ../tests/test_cairn_session.py run it with stand-ins for `id`, `labwc`,
# `startplasma-wayland` and `systemctl` and check which one it chose.
set -ouex pipefail

# Where provisioning puts the kiosk configuration (provision/README.md).
# The Phase 1 package will set its own path here.
labwc_config="${CAIRN_LABWC_CONFIG:-/usr/local/share/cairn/labwc}"

# One line, one word per group, so a name can be matched whole: `cairn-l1`
# must never match inside another name.
groups="$(id -nG | tr ' ' '\n')"

in_group() {
    grep -qx -- "$1" <<< "$groups"
}

# The child's language folder, which only root writes: cairn-family
# set-language puts plasma-localerc in it (ADR-0058). The login comes from
# the account database, never from the environment.
language_dir="/var/lib/cairn/locale/$(id -un)"

# For the kiosk, which has no startplasma to read the file: each LANG,
# LANGUAGE or LC_ variable in it, with its [$i] lock taken off, and only a
# value made of a locale's characters. Every other line is passed over.
# The child's systemd gets them too, for what it starts, such as Steam at
# login (ADR-0027), as Plasma does for its own. No language must never
# mean no login.
export_language() {
    local line key value
    local names=()
    [ -f "$language_dir/plasma-localerc" ] || return 0
    while IFS= read -r line; do
        key="${line%%=*}"
        key="${key%"[\$i]"}"
        value="${line#*=}"
        if [[ "$key" =~ ^(LANG|LANGUAGE|LC_[A-Z]+)$ && "$value" =~ ^[A-Za-z0-9_.:@-]+$ ]]; then
            export "$key=$value"
            names+=("$key")
        fi
    done < "$language_dir/plasma-localerc"
    if [ "${#names[@]}" -gt 0 ]; then
        systemctl --user import-environment "${names[@]}" || true
    fi
}

# An administrator is checked first. PAM asked them for a password even if
# they are also in a level group (#101), so the kiosk would only lock a
# parent out of their own machine.
if in_group cairn-guardian || in_group wheel; then
    exec startplasma-wayland
fi

# Then the kiosk. An account that is somehow in two level groups gets the
# more restricted session, never the less; provisioning passes through that
# state when it moves a child between levels (#100).
if in_group cairn-l1 || in_group cairn-l2; then
    # Sound before the first app (#87). PipeWire starts on demand, when the
    # first program opens audio, and at login that is the child's first app,
    # which hung while it started. Plasma starts it for itself; the kiosk
    # does not. pipewire-pulse brings PipeWire and WirePlumber with it.
    # No sound must never mean no login.
    systemctl --user start pipewire-pulse.service || true
    export_language
    # Everything the kiosk prints goes to the journal, where a grown-up can
    # read it after the next login (#122): `journalctl -t cairn-kiosk`.
    # Otherwise SDDM puts it in the child's own ~/.cache/wayland-errors and
    # replaces it at every login. No journal must never mean no login.
    if systemd-cat --identifier=cairn-kiosk true > /dev/null 2>&1; then
        exec systemd-cat --identifier=cairn-kiosk labwc -C "$labwc_config" -S cairn-launcher
    fi
    exec labwc -C "$labwc_config" -S cairn-launcher
fi

# Plasma reads the child's language file, and Cairn's Kiosk file that hides
# its language settings, through XDG_CONFIG_DIRS. KConfig reads the last
# folder first, and an entry locked with [$i] there wins over every file
# read after it, the child's own ~/.config included. Before /etc/xdg the
# locks would lose to the base image's locked group in its kdeglobals.
# Unset, the list is the one Fedora's plasma-workspace env.sh gives.
if in_group cairn-l3 || in_group cairn-l4; then
    config_dirs="${XDG_CONFIG_DIRS:-/etc/xdg:/usr/share/kde-settings/kde-profile/default/xdg}"
    config_dirs="$config_dirs:/usr/local/share/cairn/child-xdg"
    if [ -d "$language_dir" ]; then
        config_dirs="$config_dirs:$language_dir"
    fi
    export XDG_CONFIG_DIRS="$config_dirs"
    exec startplasma-wayland
fi

# Not a Cairn account at all. Plasma is what the machine gave it before
# Cairn arrived, so nothing is taken away and nothing is granted. Giving
# such an account a level is the Guardian tool's job (ADR-0023).
exec startplasma-wayland
