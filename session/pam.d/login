# Fedora's stock /etc/pam.d/login (util-linux 2.41 in Fedora 44) with one
# line added (ADR-0032): a child whose Steam a grown-up has open from their
# own login cannot log in at a text console until the visit closes. The
# helper lists them in /run/cairn/steam-visits. With no list, or one PAM
# cannot read, everyone is let in as before, so the helper opens a visit only
# once SELinux lets the login programs read it. The same line is in the login
# screen's session/sddm/pam.d/sddm.
auth       substack     system-auth
auth       include      postlogin
account    requisite    pam_listfile.so item=user sense=deny onerr=succeed file=/run/cairn/steam-visits
account    required     pam_nologin.so
account    include      system-auth
password   include      system-auth
# pam_selinux.so close should be the first session rule
session    required     pam_selinux.so close
session    required     pam_loginuid.so
# pam_selinux.so open should only be followed by sessions to be executed in the user context
session    required     pam_selinux.so open
session    required     pam_namespace.so
session    optional     pam_keyinit.so force revoke
session    include      system-auth
session    include      postlogin
-session   optional     pam_ck_connector.so
