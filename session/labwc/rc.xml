<!--
  labwc in kiosk configuration for L1 and L2 sessions (DESIGN §4.5,
  ADR-0004). The session dispatcher (ADR-0012) starts it as
  `labwc -C <this directory> -S cairn-launcher`, so the compositor ends when
  the launcher does. On the dev PC, launcher/README.md shows the nested form.

  What the launcher needs, plus the Steam rules from the P0-10 spike
  (docs/research/steam-containment.md), the child's leave key (ADR-0019)
  and the grown-up's key for a stuck app (ADR-0018).
-->
<labwc_config>
  <core>
    <!-- Windows draw no titlebars; nothing here is meant to be moved. -->
    <decoration>client</decoration>
  </core>

  <!--
    labwc loads its default keybinds (Alt-Tab, Alt-F4, Super-Return, the
    window menu and more) whenever a config defines none at all. The two
    real bindings below, the ways out, keep them off. The Alt-Tab binding
    that does nothing is only a fallback in case those are ever removed:
    labwc drops a binding with no action, but only after that check. The
    debug log line to watch for on an upgrade is "load default key
    bindings", whose absence is the pass. Ctrl-Alt-Fn VT switching is not a
    keybind and is handled in the `environment` file beside this one. See
    docs/research/kiosk-containment.md.
  -->
  <keyboard>
    <keybind key="A-Tab">
      <action name="None" />
    </keybind>
    <!--
      The grown-up's way out of a stuck program (ADR-0018, issue #41).
      A frozen app cannot answer the child's leave key (Super+Q, below).
      This ends whatever was launched and leaves the launcher, which
      is already behind it, on screen. Deliberately not a plain key: it is
      for the adult at the keyboard, not a combination a five-year-old finds.
      cairn-give-up only ever ends sandboxed apps, never the frame.
    -->
    <keybind key="C-A-Home">
      <action name="Execute" command="cairn-give-up" />
    </keybind>
    <!--
      The child's own way out of an app (ADR-0019, issue #77): Super+Q asks
      the window in front to close, as a titlebar's close button would, so
      an app that asks "save first?" still asks. When the launcher is in
      front the request reaches it too, and there it is one step back,
      never the end of the session (launcher/src/CloseRequest.h). A frozen
      app ignores a polite close; that stays Ctrl-Alt-Home's job above.
      On release, because labwc repeats a held binding 25 times a second,
      and a held key would open and close Tux Paint's question over and
      over; on release it closes once, however long the key is held.
    -->
    <keybind key="W-q" onRelease="yes">
      <action name="Close" />
    </keybind>
    <!--
      A laptop's volume keys (#43). labwc's own defaults bind them, but the
      kiosk turns those off, so they are bound again here, through
      PipeWire's wpctl. Volume stops at 100%, never louder than the speaker
      was made for; a held key steps on, as it does anywhere else.
    -->
    <keybind key="XF86_AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86_AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86_AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
  </keyboard>

  <!--
    The mouse has no real binding, so this one that does nothing is all that
    keeps labwc's default mousebinds out: the right-click root menu, the
    window menu and Super-drag. It works only because labwc drops it after
    the empty-list check; watch for "load default mouse bindings" on an
    upgrade.
  -->
  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="None" />
      </mousebind>
    </context>
  </mouse>

  <windowRules>
    <!--
      Every window, whichever way it arrived: no titlebar, and no taking
      focus by asking for it. `<decoration>client</decoration>` above only
      governs Wayland clients; an X11 window under XWayland still got a
      titlebar with close and minimise buttons. labwc honours an X11
      _NET_ACTIVE_WINDOW or a Wayland xdg-activation request unless told
      not to, and a window that asked was given focus over the launcher. A
      window that opens normally is still focused, so a launched app comes
      up in front as before. Later rules win, so this one goes first.
    -->
    <windowRule identifier="*" serverDecoration="no" ignoreFocusRequest="yes" />

    <!--
      The launcher is the whole screen. Fullscreen is the compositor's
      decision, made here per session, never a launcher option: under Plasma
      the same program is an ordinary window.
    -->
    <windowRule identifier="cairn-launcher" serverDecoration="no" fixedPosition="yes">
      <action name="ToggleFullscreen" />
    </windowRule>

    <!--
      Steam's own windows never reach the child: the sign-in prompt, the
      main client, an update. They are X11 windows under XWayland, and
      labwc matches `identifier` against the first half of WM_CLASS, the
      instance, not the class: the client's windows are
      "steamwebhelper", "steam", and a rule for "steam" did nothing while
      one for "steamwebhelper" hid the sign-in window from its first map
      (P0-10, 2026-09-08). "steam" is kept for the bootstrapper that runs
      before the web helper exists.

      Iconify hides the window but keeps its foreign-toplevel handle, so
      the launcher still hears about it and shows "Something needs a
      grown-up". skipTaskbar="yes" would drop the handle too, and then the
      child would see the tiles and nothing else; that is not what DESIGN
      §8.3 asks for, so it is not set.
    -->
    <windowRule identifier="steamwebhelper">
      <action name="Iconify" />
    </windowRule>
    <windowRule identifier="steam">
      <action name="Iconify" />
    </windowRule>
  </windowRules>
</labwc_config>
