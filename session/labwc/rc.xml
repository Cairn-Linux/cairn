<!--
  labwc in kiosk configuration for L1 and L2 sessions (DESIGN §4.5,
  ADR-0004). The session dispatcher (ADR-0012) starts it as
  `labwc -C <this directory> -S cairn-launcher`, so the compositor ends when
  the launcher does. On the dev PC, launcher/README.md shows the nested form.

  What the launcher needs, plus the Steam rules from the P0-10 spike
  (docs/research/steam-containment.md). The escape hatch for hung apps is
  issue #41.
-->
<labwc_config>
  <core>
    <!-- Windows draw no titlebars; nothing here is meant to be moved. -->
    <decoration>client</decoration>
  </core>

  <!--
    labwc loads its default keybinds (Alt-Tab, Alt-F4, Super-Return, the
    window menu and more) whenever a config defines none at all, so one
    binding that does nothing is what turns them off. labwc drops a binding
    with no action only after that check; the debug log line to watch for
    on an upgrade is "load default key bindings", whose absence is the pass.
    Ctrl-Alt-Fn VT switching is not a keybind and is handled in the
    `environment` file beside this one. See docs/research/kiosk-containment.md.
  -->
  <keyboard>
    <keybind key="A-Tab">
      <action name="None" />
    </keybind>
  </keyboard>

  <!-- Likewise for the default mousebinds, including the right-click root menu. -->
  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="None" />
      </mousebind>
    </context>
  </mouse>

  <windowRules>
    <!--
      Every window, whichever way it arrived: no titlebar, and no taking
      focus by asking for it. `<decoration>client</decoration>` above only
      governs Wayland clients; an X11 window under XWayland still got a
      titlebar with close and minimise buttons. labwc honours an X11
      _NET_ACTIVE_WINDOW or a Wayland xdg-activation request unless told
      not to, and a window that asked was given focus over the launcher. A
      window that opens normally is still focused, so a launched app comes
      up in front as before. Later rules win, so this one goes first.
    -->
    <windowRule identifier="*" serverDecoration="no" ignoreFocusRequest="yes" />

    <!--
      The launcher is the whole screen. Fullscreen is the compositor's
      decision, made here per session, never a launcher option: under Plasma
      the same program is an ordinary window.
    -->
    <windowRule identifier="cairn-launcher" serverDecoration="no" fixedPosition="yes">
      <action name="ToggleFullscreen" />
    </windowRule>

    <!--
      Steam's own windows never reach the child: the sign-in prompt, the
      main client, an update. They are X11 windows under XWayland, and
      labwc matches `identifier` against the first half of WM_CLASS, the
      instance, not the class: the client's windows are
      "steamwebhelper", "steam", and a rule for "steam" did nothing while
      one for "steamwebhelper" hid the sign-in window from its first map
      (P0-10, 2026-09-08). "steam" is kept for the bootstrapper that runs
      before the web helper exists.

      Iconify hides the window but keeps its foreign-toplevel handle, so
      the launcher still hears about it and shows "Something needs a
      grown-up". skipTaskbar="yes" would drop the handle too, and then the
      child would see the tiles and nothing else; that is not what DESIGN
      §8.3 asks for, so it is not set.
    -->
    <windowRule identifier="steamwebhelper">
      <action name="Iconify" />
    </windowRule>
    <windowRule identifier="steam">
      <action name="Iconify" />
    </windowRule>
  </windowRules>
</labwc_config>
