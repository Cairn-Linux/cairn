// SPDX-License-Identifier: Apache-2.0
//
// What a child's session may ask the system to do (ADR-0011, issue #35).
//
// polkit decides whether a process may power the machine off, mount a USB
// stick, change Wi-Fi, install or update software. Fedora's defaults say yes
// to most of that for any user sitting at the console, which is right for a
// laptop and wrong for a five-year-old. This file answers first, keyed off
// the level groups, and returns NO where DESIGN §3.2 gives the action to the
// Guardian. Anything not named here falls through to the defaults.
// An administrator (cairn-guardian or wheel) is checked first and always
// falls through, even from a level group, in the order PAM and the session
// dispatcher use (ADR-0023, #101). Cairn's own actions are for an
// administrator only, so every other account gets NO for them, before
// polkit asks for any password (ADR-0032).
//
// Installed as /etc/polkit-1/rules.d/10-cairn-levels.rules. polkit reads
// rule files in name order and the first answer wins, so the low number
// keeps this ahead of anything the base image ships.

// polkit runs every rule file in one JavaScript context, so a function or
// a list named at the top of one file is replaced by one of the same name
// in a file read later, and the rule below would then use the later one.
// Everything from here on is inside one function, which keeps its names to
// this file. The lines inside are not indented, so the file reads as before.
(function () {

// An action id "starts with" a prefix. Duktape, polkit's engine, has no
// String.startsWith, so this is the plain form.
function startsWith(id, prefix) {
    return id.indexOf(prefix) === 0;
}

function startsWithAny(id, prefixes) {
    for (var i = 0; i < prefixes.length; i++) {
        if (startsWith(id, prefixes[i])) {
            return true;
        }
    }
    return false;
}

// A name is one of a list: the whole name, never a prefix.
function isOneOf(name, names) {
    for (var i = 0; i < names.length; i++) {
        if (name === names[i]) {
            return true;
        }
    }
    return false;
}

// The Guardian owns Wi-Fi, updates and parental controls (DESIGN §3.2), at
// every level of the ladder. Reading one's own parental-control settings is
// left alone: malcontent's Flatpak check runs as the child and needs it.
var guardianOnly = [
    "org.freedesktop.NetworkManager.",
    "org.freedesktop.Flatpak.",
    "org.freedesktop.packagekit.",
    "org.projectatomic.rpmostree1.",
    "com.endlessm.ParentalControls.AccountInfo.Change",
    "com.endlessm.ParentalControls.AppFilter.Change",
    "com.endlessm.ParentalControls.SessionLimits.Change",
    "org.freedesktop.Malcontent.WebFilter.Change",
    "org.freedesktop.Malcontent.SessionLimits.Extend",
    "org.freedesktop.MalcontentControl."
];

// The base image's updater, uupd, is three systemd units: uupd.service,
// which uupd.timer starts every night, uupd-manual.service, which starts
// when an update is asked for by hand, and the timer. systemd has one
// action for every unit, manage-units, and tells polkit which unit and what
// is asked of it, the verb. For most units the answer is a grown-up's
// password, but Universal Blue's own rule file, uupd.rules, says yes for
// the two services to any account, whatever the verb (#265). Updates are
// the Guardian's, so a child is refused here first, for every verb:
// stopping an update half-way is the Guardian's as much as starting one,
// and a rule that does not read the verb cannot miss one systemd adds
// later. The timer is listed with them, so that stopping the nightly update
// is a plain no for a child and not a password box. The timer still starts
// uupd.service by itself, since systemd does that without asking polkit.
// Every other unit keeps systemd's default, and so does turning a unit off
// for good, which is another action, manage-unit-files, and names no unit.
var manageUnits = "org.freedesktop.systemd1.manage-units";
var updaterUnits = [
    "uupd.service",
    "uupd-manual.service",
    "uupd.timer"
];

// The kiosk has nothing on screen that powers off, sleeps or mounts, so
// nothing behind it may either. L3 and L4 run Plasma, whose menu offers
// these; there Fedora's defaults stand. The set-reboot-* actions are
// listed because logind's policy says being allowed them implies being
// allowed to reboot, and they default to yes for anyone at the console.
// Nor may a program behind the kiosk move the screen to another session,
// such as a grown-up's lock screen, or take logind's lock on the power key
// itself, which stops the button's five-second hold, the parents' way out
// of a screen that looks wrong (ADR-0018, ADR-0049). Both default to yes
// at the console too. A shutdown lock would stop the hold as well, so
// logind ignores those for the hold (logind.conf.d/10-cairn-power.conf).
var notInTheKiosk = [
    "org.freedesktop.login1.power-off",
    "org.freedesktop.login1.reboot",
    "org.freedesktop.login1.set-reboot-",
    "org.freedesktop.login1.halt",
    "org.freedesktop.login1.suspend",
    "org.freedesktop.login1.hibernate",
    "org.freedesktop.login1.chvt",
    "org.freedesktop.login1.inhibit-handle-power-key",
    "org.freedesktop.udisks2."
];

// Cairn's own actions, such as opening a child's Steam from a grown-up's
// login (ADR-0032). A child at any level, and an account Cairn did not
// make, never sees the password prompt for one.
var cairnActions = "com.cairnlinux.";

polkit.addRule(function (action, subject) {
    if (subject.isInGroup("cairn-guardian") || subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    if (startsWith(action.id, cairnActions)) {
        return polkit.Result.NO;
    }

    var kiosk = subject.isInGroup("cairn-l1") || subject.isInGroup("cairn-l2");
    var desktop = subject.isInGroup("cairn-l3") || subject.isInGroup("cairn-l4");

    if (!kiosk && !desktop) {
        return polkit.Result.NOT_HANDLED;
    }
    if (startsWithAny(action.id, guardianOnly)) {
        return polkit.Result.NO;
    }
    if (action.id === manageUnits &&
            isOneOf(action.lookup("unit"), updaterUnits)) {
        return polkit.Result.NO;
    }
    if (kiosk && startsWithAny(action.id, notInTheKiosk)) {
        return polkit.Result.NO;
    }
    return polkit.Result.NOT_HANDLED;
});

}());
