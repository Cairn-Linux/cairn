<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!--
  cairn-family's subcommands (ADR-0039, ADR-0041, ADR-0043): making a
  child's account, changing a child's level, saving a child's games,
  logging a child out before a grown-up chooses their games, and a
  grown-up's own new password. The Guardian's tool
  runs cairn-family through pkexec, which finds the action by the command's
  path and its first argument, and asks for an administrator's password, or
  a fingerprint, for every change, with the message of that subcommand.
  The Games page's Look for new games is save-games with no child named,
  which changes no child's games, and pkexec looks no further than the
  first argument, so save-games's message speaks of both (#220).
  A grown-up's own new password asks for that grown-up's own password,
  auth_self, so the password they use now is what lets them change it,
  and no other grown-up's will do.

  Every action names its first argument, so pkexec never picks one by the
  path alone, whatever order polkit lists them in. Any other first argument
  falls back to pkexec's own action, which also asks for an administrator,
  and cairn-family refuses it with `usage`. polkit's levels rule answers no
  to all of them, before any prompt, for every account that is not an
  administrator. The image installs this file in /usr/share/polkit-1/actions
  with the path the image puts the command at.
-->
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Cairn Linux</vendor>
  <vendor_url>https://cairnlinux.com</vendor_url>
  <action id="com.cairnlinux.family.create-child">
    <description>Change a child's account</description>
    <message>A grown-up's password is needed to change a child's account.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/cairn/cairn-family</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">create-child</annotate>
  </action>
  <action id="com.cairnlinux.family.set-level">
    <description>Change a child's account</description>
    <message>A grown-up's password is needed to change a child's account.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/cairn/cairn-family</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-level</annotate>
  </action>
  <action id="com.cairnlinux.family.save-games">
    <description>Look for new games, or change which games a child has</description>
    <message>A grown-up's password is needed to look for new games, or to change which games a child has.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/cairn/cairn-family</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">save-games</annotate>
  </action>
  <action id="com.cairnlinux.family.log-out">
    <description>Log a child out</description>
    <message>A grown-up's password is needed to log a child out.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/cairn/cairn-family</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">log-out</annotate>
  </action>
  <action id="com.cairnlinux.family.set-own-password">
    <description>Change your own password</description>
    <message>Type the password you use now to change it.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/cairn/cairn-family</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-own-password</annotate>
  </action>
</policyconfig>
