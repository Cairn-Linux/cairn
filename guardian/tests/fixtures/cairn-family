#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# A stand-in for cairn-family behind pkexec-family, for the Guardian
# tool's tests. CAIRN_TEST_SCENARIO says how it answers, including
# pkexec's own 126 and 127. When CAIRN_TEST_ARGUMENTS names a file, each
# argument is written to it on a line of its own, and each run adds a
# line "run" first.
#
# The save-* scenarios answer save-games in many lines, as the real
# command does (ADR-0041). save-done gives each child named every game on
# their new list, and writes their list into the folder
# CAIRN_TEST_GAMES names, when it names one, with an entry for each game.
# save-looking says its first line, then makes the pictures for a long
# time. The save-held-* scenarios count the games taken off against the child's list in
# CAIRN_TEST_GAMES, as the real command does, and write nothing there.
# The tools folder is made after the full list (ADR-0046): save-sharing-tools
# takes a long time there, save-tools-left-out says a tool stayed out, and
# save-tools-kept-but-held says the folder was kept and then holds every
# child. Each child's copy gives them two of Steam's tools in save-tools,
# one and a missing one in save-tools-missing, none in save-no-tools, and
# save-tools-copying is still copying the tools. The pictures are made
# first (ADR-0047): save-pictures-kept says they were kept, and
# save-pictures-missing and save-pictures-refused name game 1008 without a
# picture; each then goes on as save-done.
#
# For set-own-password, when CAIRN_TEST_INPUT names a file, what came on
# standard input is written to it, as the real command reads the new
# password there (ADR-0043). Other subcommands never read it.
#
# The log-out-* scenarios answer `log-out LOGIN`: log-out-done logs the
# child out, log-out-held-WORD says why it did not, and log-out-running
# says its first line and then takes a long time. When CAIRN_TEST_LOGGED_IN
# names a file, log-out-done empties it, as the child's sessions end.
set -u
scenario="${CAIRN_TEST_SCENARIO:-}"
if [ -n "${CAIRN_TEST_ARGUMENTS:-}" ]; then
    { echo run; printf '%s\n' "$@"; } >> "$CAIRN_TEST_ARGUMENTS"
fi
if [ "${1:-}" = set-own-password ] && [ -n "${CAIRN_TEST_INPUT:-}" ]; then
    cat > "$CAIRN_TEST_INPUT"
fi

# A child's list as the launcher's games file.
write_list() {
    local login="$1" ids="$2" id first=yes
    [ -n "${CAIRN_TEST_GAMES:-}" ] || return 0
    {
        printf '{"version": 1, "entries": ['
        for id in ${ids//,/ }; do
            [ "$first" = yes ] || printf ', '
            first=no
            printf '{"id": "steam-%s", "title": "Game %s", "category": "games", "exec": ["steam", "-applaunch", "%s"]}' "$id" "$id" "$id"
        done
        printf ']}\n'
    } > "$CAIRN_TEST_GAMES/$login.json"
}

# How many games on the child's list in CAIRN_TEST_GAMES are not among
# the appids given.
taken_off() {
    local login="$1" ids="$2" id count=0 file
    file="${CAIRN_TEST_GAMES:-}/$login.json"
    if [ -n "${CAIRN_TEST_GAMES:-}" ] && [ -f "$file" ]; then
        for id in $(grep -o '"steam-[0-9]*"' "$file" | tr -dc '0-9\n'); do
            case ",$ids," in
                *",$id,"*) ;;
                *) count=$((count + 1)) ;;
            esac
        done
    fi
    echo "$count"
}

# Each child of a save-games run, in turn, as the scenario says.
save_games() {
    local argument login ids id count
    echo "looking"
    if [ "$scenario" = save-looking ]; then
        exec sleep 30
    fi
    if [ "$scenario" = save-pictures-kept ]; then
        echo "pictures kept"
    else
        echo "pictures made"
    fi
    echo "catalogue made"
    case "$scenario" in
        save-pictures-missing) echo "picture-missing 1008" ;;
        save-pictures-refused) echo "picture-refused 1008" ;;
    esac
    case "$scenario" in
        save-sharing-tools) exec sleep 30 ;;
        save-tools-kept-but-held) echo "tools kept" ;;
        *) echo "tools made" ;;
    esac
    if [ "$scenario" = save-tools-left-out ]; then
        echo "tool-not-shared 1493710 downloading"
    fi
    for argument in "${@:2}"; do
        login="${argument%%=*}"
        ids="${argument#*=}"
        count=0
        for id in ${ids//,/ }; do
            count=$((count + 1))
        done
        case "$scenario" in
            save-done | save-pictures-*)
                if [ -n "$ids" ]; then
                    echo "copying $login"
                    for id in ${ids//,/ }; do
                        echo "copied $login $id"
                    done
                fi
                write_list "$login" "$ids"
                echo "child $login added $count removed 0"
                ;;
            save-held-*)
                echo "child $login added 0 removed $(taken_off "$login" "$ids") held ${scenario#save-held-}"
                ;;
            save-skipped)
                for id in ${ids//,/ }; do
                    echo "skipped $login $id downloading"
                done
                echo "child $login added 0 removed 0"
                ;;
            save-copying)
                echo "copying $login"
                exec sleep 30
                ;;
            save-copied-then-copying)
                echo "copying $login"
                echo "copied $login 1001"
                echo "have $login 1002"
                exec sleep 30
                ;;
            save-cut-off)
                exit 1
                ;;
            save-tools | save-tools-missing | save-no-tools | save-tools-left-out)
                echo "copying $login"
                for id in ${ids//,/ }; do
                    echo "copied $login $id"
                done
                case "$scenario" in
                    save-tools)
                        printf 'copying-tools %s\ntool-copied %s 1070560\ntool-copied %s 1391110\n' \
                            "$login" "$login" "$login"
                        ;;
                    save-tools-missing)
                        printf 'copying-tools %s\ntool-copied %s 1070560\ntool-missing %s 1391110\n' \
                            "$login" "$login" "$login"
                        ;;
                    save-no-tools) echo "no-tools $login" ;;
                    save-tools-left-out)
                        printf 'copying-tools %s\ntool-copied %s 1070560\n' "$login" "$login"
                        ;;
                esac
                write_list "$login" "$ids"
                echo "child $login added $count removed 0"
                ;;
            save-tools-copying)
                echo "copying $login"
                echo "copied $login 1001"
                echo "copying-tools $login"
                exec sleep 30
                ;;
            save-tools-kept-but-held)
                echo "copying $login"
                echo "child $login added 0 removed 0 held logged-in"
                ;;
        esac
    done
    echo "done"
}

# A child's logout, as the scenario says.
log_out() {
    local login="${2:-}"
    echo "logging-out $login"
    case "$scenario" in
        log-out-done)
            [ -z "${CAIRN_TEST_LOGGED_IN:-}" ] || : > "$CAIRN_TEST_LOGGED_IN"
            echo "logged-out $login"
            ;;
        log-out-held-*) echo "held $login ${scenario#log-out-held-}" ;;
        log-out-running) exec sleep 30 ;;
    esac
    echo "done"
}

case "$scenario" in
    save-*) save_games "$@" ;;
    log-out-*) log_out "$@" ;;
    done) echo "done" ;;
    refused-*) echo "refused ${scenario#refused-}"; exit 1 ;;
    # pkexec's own: the box was dismissed, or the password not accepted.
    dismissed) exit 126 ;;
    not-authorized) exit 127 ;;
    # The Guardian has not answered the box yet.
    asking) exec sleep 30 ;;
    # Answers the window cannot read.
    silent) exit 0 ;;
    garbage) echo "it went fine"; exit 0 ;;
    two-lines) echo "done"; echo "done" ;;
    done-but-failed) echo "done"; exit 1 ;;
    zero-after-refused) echo "refused taken" ;;
    crashes) kill -KILL $$ ;;
    # A line far longer than any the command says, then its answer.
    long-line) printf '%0300d\n' 0; echo "done" ;;
    *) exit 1 ;;
esac
