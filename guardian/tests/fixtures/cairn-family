#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# A stand-in for cairn-family behind pkexec-family, for the Guardian
# tool's tests. CAIRN_TEST_SCENARIO says how it answers, including
# pkexec's own 126 and 127. When CAIRN_TEST_ARGUMENTS names a file, each
# argument is written to it on a line of its own, and each run adds a
# line "run" first.
#
# The save-* scenarios answer save-games in many lines, as the real
# command does (ADR-0041). save-done gives each child named every game on
# their new list, and writes their list into the folder
# CAIRN_TEST_GAMES names, when it names one, with an entry for each game.
# save-looking says its first line, then makes the pictures for a long
# time. save-held-later holds each child as logged in and says `later`,
# and writes their waiting list into the folder CAIRN_TEST_WAITING names,
# when it names one, as the real command does. A child named with
# --log-out=LOGIN is logged out first in save-done, and in save-stuck one
# of their programs will not close, so they are held as stuck and wait.
# save-logging-out stays logging the first child out. The save-held-*
# scenarios count the games taken off against the child's list in
# CAIRN_TEST_GAMES, as the real command does, and write nothing there.
set -u
scenario="${CAIRN_TEST_SCENARIO:-}"
if [ -n "${CAIRN_TEST_ARGUMENTS:-}" ]; then
    { echo run; printf '%s\n' "$@"; } >> "$CAIRN_TEST_ARGUMENTS"
fi

# A child's list as the launcher's games file.
write_list() {
    local login="$1" ids="$2" id first=yes
    [ -n "${CAIRN_TEST_GAMES:-}" ] || return 0
    {
        printf '{"version": 1, "entries": ['
        for id in ${ids//,/ }; do
            [ "$first" = yes ] || printf ', '
            first=no
            printf '{"id": "steam-%s", "title": "Game %s", "category": "games", "exec": ["steam", "-applaunch", "%s"]}' "$id" "$id" "$id"
        done
        printf ']}\n'
    } > "$CAIRN_TEST_GAMES/$login.json"
}

# How many games on the child's list in CAIRN_TEST_GAMES are not among
# the appids given.
taken_off() {
    local login="$1" ids="$2" id count=0 file
    file="${CAIRN_TEST_GAMES:-}/$login.json"
    if [ -n "${CAIRN_TEST_GAMES:-}" ] && [ -f "$file" ]; then
        for id in $(grep -o '"steam-[0-9]*"' "$file" | tr -dc '0-9\n'); do
            case ",$ids," in
                *",$id,"*) ;;
                *) count=$((count + 1)) ;;
            esac
        done
    fi
    echo "$count"
}

# Each child of a save-games run, in turn, as the scenario says.
save_games() {
    local argument login ids id count log_out=" "
    echo "looking"
    if [ "$scenario" = save-looking ]; then
        exec sleep 30
    fi
    echo "pictures made"
    echo "catalogue made"
    for argument in "${@:2}"; do
        case "$argument" in
            --log-out=*)
                log_out+="${argument#--log-out=} "
                continue
                ;;
        esac
        login="${argument%%=*}"
        ids="${argument#*=}"
        count=0
        for id in ${ids//,/ }; do
            count=$((count + 1))
        done
        case "$scenario" in
            save-stuck)
                if [ "${log_out#* "$login" }" != "$log_out" ]; then
                    echo "copying $login"
                    echo "logging-out $login"
                    echo "child $login added 0 removed 0 held stuck"
                    if [ -n "${CAIRN_TEST_WAITING:-}" ]; then
                        mkdir -p "$CAIRN_TEST_WAITING"
                        echo "$argument" > "$CAIRN_TEST_WAITING/$login"
                    fi
                    echo "later $login"
                else
                    write_list "$login" "$ids"
                    echo "child $login added $count removed 0"
                fi
                ;;
            save-done)
                if [ -n "$ids" ]; then
                    echo "copying $login"
                    if [ "${log_out#* "$login" }" != "$log_out" ]; then
                        echo "logging-out $login"
                        echo "logged-out $login"
                    fi
                    for id in ${ids//,/ }; do
                        echo "copied $login $id"
                    done
                fi
                write_list "$login" "$ids"
                echo "child $login added $count removed 0"
                ;;
            save-held-later)
                echo "copying $login"
                echo "child $login added 0 removed $(taken_off "$login" "$ids") held logged-in"
                if [ -n "${CAIRN_TEST_WAITING:-}" ]; then
                    mkdir -p "$CAIRN_TEST_WAITING"
                    echo "$argument" > "$CAIRN_TEST_WAITING/$login"
                fi
                echo "later $login"
                ;;
            save-held-*)
                echo "child $login added 0 removed $(taken_off "$login" "$ids") held ${scenario#save-held-}"
                ;;
            save-skipped)
                for id in ${ids//,/ }; do
                    echo "skipped $login $id downloading"
                done
                echo "child $login added 0 removed 0"
                ;;
            save-copying)
                echo "copying $login"
                exec sleep 30
                ;;
            save-logging-out)
                echo "copying $login"
                echo "logging-out $login"
                exec sleep 30
                ;;
            save-cut-off)
                exit 1
                ;;
        esac
    done
    echo "done"
}

case "$scenario" in
    save-*) save_games "$@" ;;
    done) echo "done" ;;
    refused-*) echo "refused ${scenario#refused-}"; exit 1 ;;
    # pkexec's own: the box was dismissed, or the password not accepted.
    dismissed) exit 126 ;;
    not-authorized) exit 127 ;;
    # The Guardian has not answered the box yet.
    asking) exec sleep 30 ;;
    # Answers the window cannot read.
    silent) exit 0 ;;
    garbage) echo "it went fine"; exit 0 ;;
    two-lines) echo "done"; echo "done" ;;
    done-but-failed) echo "done"; exit 1 ;;
    zero-after-refused) echo "refused taken" ;;
    crashes) kill -KILL $$ ;;
    # A line far longer than any the command says, then its answer.
    long-line) printf '%0300d\n' 0; echo "done" ;;
    *) exit 1 ;;
esac
