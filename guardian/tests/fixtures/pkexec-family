#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# A stand-in for pkexec with cairn-family behind it, for the Guardian
# tool's tests. The tests pass a scenario where the command's path goes;
# the rest are the arguments the window gave cairn-family. When
# CAIRN_TEST_ARGUMENTS names a file, each argument is written to it on a
# line of its own, and each run adds a line "run" first.
set -u
scenario="$1"
shift
if [ -n "${CAIRN_TEST_ARGUMENTS:-}" ]; then
    { echo run; printf '%s\n' "$@"; } >> "$CAIRN_TEST_ARGUMENTS"
fi

case "$scenario" in
    done) echo "done" ;;
    refused-*) echo "refused ${scenario#refused-}"; exit 1 ;;
    # pkexec's own: the box was dismissed, or the password not accepted.
    dismissed) exit 126 ;;
    not-authorized) exit 127 ;;
    # The Guardian has not answered the box yet.
    asking) exec sleep 30 ;;
    # Answers the window cannot read.
    silent) exit 0 ;;
    garbage) echo "it went fine"; exit 0 ;;
    two-lines) echo "done"; echo "done" ;;
    done-but-failed) echo "done"; exit 1 ;;
    zero-after-refused) echo "refused taken" ;;
    crashes) kill -KILL $$ ;;
    *) exit 1 ;;
esac
