#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# A stand-in for pkexec, for the Guardian tool's tests. Like pkexec, it
# refuses a command that is not there with exit 127 before it asks
# anything, and otherwise runs the command with the arguments it was
# given. The tests give it the stand-in `cairn-family` next to it.
set -u
command="$1"
if [ ! -x "$command" ]; then
    echo "Error accessing $command: No such file or directory" >&2
    exit 127
fi
exec "$@"
