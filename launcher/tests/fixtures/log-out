#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Stands in for session/bin/cairn-log-out in the tests: adds a line to a mark
# where the test asked, one for every run, and ends nothing.
set -ouex pipefail
if [ -n "${CAIRN_TEST_LOG_OUT_MARK:-}" ]; then
    echo ran >> "$CAIRN_TEST_LOG_OUT_MARK"
fi
