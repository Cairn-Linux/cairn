{
  "$schema": "cairn-brand-tokens-v0.1",
  "source": "docs/brand-guide/Cairn Brand Guide.dc.html (brand guidelines v0.1, September 2026)",
  "color": {
    "ink": {
      "hex": "#1C333C",
      "role": "Text, the mark, the only dark ground (terminal, login, boot)"
    },
    "fjord": {
      "hex": "#2E6276",
      "role": "Accent, links, machine tiles"
    },
    "sky": {
      "hex": "#A5C8D6",
      "role": "Tints, selection, focus ring, hint text on Ink"
    },
    "ochre": {
      "hex": "#D9A03C",
      "role": "Make tiles (draw, music, build). Large fills only, never text"
    },
    "moss": {
      "hex": "#7C956A",
      "role": "Practice tiles (GCompris, Tux). Large fills only, never text"
    },
    "sand": {
      "hex": "#F4EDE0",
      "role": "Everyday ground"
    },
    "paper": {
      "hex": "#FBF7EF",
      "role": "Cards on Sand"
    },
    "pebble": {
      "hex": "#E8DFCC",
      "role": "Pill and chip fill on Sand (derived tint used in the guide)"
    },
    "line": {
      "hex": "#E0D5BF",
      "role": "Hairline borders on Sand and Paper (derived tint used in the guide)"
    }
  },
  "semantic": {
    "ground": "sand",
    "card": "paper",
    "dark-ground": "ink",
    "text": "ink",
    "link": "fjord",
    "link-on-ink": "sky",
    "selection": "sky",
    "focus": "sky",
    "kind": {
      "make": "ochre",
      "practice": "moss",
      "machine": "fjord"
    },
    "on": {
      "make": "ink",
      "practice": "ink",
      "machine": "sand",
      "ink": "sand",
      "sand": "ink",
      "paper": "ink"
    }
  },
  "interaction": {
    "focus-width": 3,
    "focus-offset": 3
  },
  "contrast": {
    "ink-on-sand": 11.36,
    "ink-on-paper": 12.37,
    "fjord-on-sand": 5.77,
    "sky-on-ink": 7.45,
    "sand-on-ink": 11.36,
    "ink-on-ochre": 5.69,
    "ink-on-moss": 4.01,
    "sand-on-moss (rejected)": 2.83,
    "sand-on-fjord": 5.77
  },
  "font": {
    "family": "Atkinson Hyperlegible Next",
    "family-mono": "Atkinson Hyperlegible Mono",
    "weights": {
      "regular": 400,
      "bold": 700
    },
    "note": "One family everywhere. No display face; the wordmark is the Bold, lowercase, tracked -2%."
  },
  "type": {
    "display": {
      "size": 48,
      "weight": 700,
      "line": 1.1,
      "tracking": "-0.02em"
    },
    "heading": {
      "size": 28,
      "weight": 700,
      "line": 1.2
    },
    "body": {
      "size": 17,
      "weight": 400,
      "line": 1.65
    },
    "terminal": {
      "size": 18,
      "weight": 400,
      "line": 1.7,
      "mono": true
    },
    "kicker": {
      "size": 13,
      "weight": 700,
      "tracking": ".14em",
      "transform": "uppercase"
    },
    "min-child": 18,
    "min-guardian": 16,
    "rules": "Child-facing UI 18px minimum at 1.5 line height, sentence case. Never all-caps for content. Weights 400 and 700 only."
  },
  "radius": {
    "sm": 10,
    "tile": 18,
    "card": 20,
    "cover": 28,
    "terminal": 14,
    "pill": 999
  },
  "mark": {
    "file": "brand/mark.svg",
    "variant": "C — Trail stack",
    "viewBox": "0 0 120 110",
    "stones": [
      [
        54,
        8,
        24,
        16
      ],
      [
        34,
        30,
        44,
        16
      ],
      [
        30,
        52,
        64,
        16
      ],
      [
        16,
        74,
        88,
        16
      ]
    ],
    "rx": 8,
    "clear-space": "one base-stone height (16 units of the 120x110 box) on all sides",
    "min-size": {
      "mark-alone": "16px tall",
      "with-wordmark": "24px tall"
    },
    "rules": "Ink on light grounds, Sand on dark grounds. Never outlined, rotated, gradient-filled, or given a face."
  }
}
